{
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 6 * * *"
    }
  ]
}