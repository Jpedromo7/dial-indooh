{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "preview": {
      "channel": "stable",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dial-indooh.vercel.app/api",
        "EXPO_PUBLIC_DEVICE_CHANNEL": "stable",
        "EXPO_PUBLIC_PLAYLIST_REFRESH_MINUTES": "5",
        "EXPO_PUBLIC_HEARTBEAT_MINUTES": "2"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "stable",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dial-indooh.vercel.app/api",
        "EXPO_PUBLIC_DEVICE_CHANNEL": "stable",
        "EXPO_PUBLIC_PLAYLIST_REFRESH_MINUTES": "5",
        "EXPO_PUBLIC_HEARTBEAT_MINUTES": "2"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
