DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dial_indooh?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dial_indooh?schema=public"
# Supabase IPv4/session-pooler example:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@[CLOUD]-[REGION].pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@[CLOUD]-[REGION].pooler.supabase.com:5432/postgres"
AUTH_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-secret-for-vercel-cron"
DATABASE_POOL_MAX="1"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
MEDIA_STORAGE_PROVIDER="supabase"
MEDIA_STORAGE_BUCKET="dial-indooh-media"
MEDIA_STORAGE_PUBLIC_URL="https://your-project.supabase.co/storage/v1/object/public/dial-indooh-media"

# Set MEDIA_STORAGE_PROVIDER="r2" only after the R2 bucket, public URL and CORS are configured.
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Lista extra de prefixos de URL aceitos para arquivos de mídia (separados por vírgula).
# Por padrão só MEDIA_STORAGE_PUBLIC_URL é aceito.
# MEDIA_ALLOWED_URL_PREFIXES="https://cdn-antigo.example.com"

# Link do APK da TV (opcional; também pode ser configurado no painel em Configurações > Aplicativo da TV).
# APK_DOWNLOAD_URL="https://expo.dev/artifacts/eas/....apk"

# Retenção de logs (dias) usada pela rotina diária /api/cron/maintenance.
# HEARTBEAT_RETENTION_DAYS="30"
# EVENT_RETENTION_DAYS="60"
# PLAYLOG_RETENTION_DAYS="400"
