generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  superadmin
  admin
  operator
}

enum AccountKind {
  reseller
  client
}

enum MediaType {
  image
  video
  youtube
  url
  instagram
  rss
  clock
  currency
  weather
  notice
  quote
  countdown
  holidays
  birthdays
  qrcode
}

enum ScreenStatus {
  online
  offline
}

enum ScreenOrientation {
  landscape
  portrait
}

enum MediaStatus {
  pending
  processing
  ready
  failed
}

enum MediaOrientation {
  auto
  landscape
  portrait
  square
}

enum ScreenEventLevel {
  info
  warn
  error
}

enum ScreenCommandType {
  refresh_playlist
  clear_cache
  restart_player
  reload_app
  open_overlay_settings
  remote_key
  start_screen_mirror
  stop_screen_mirror
}

enum ScreenCommandStatus {
  pending
  delivered
  acknowledged
  failed
}

enum ScreenMirrorSessionStatus {
  requested
  connecting
  active
  ended
  failed
}

enum ScreenMirrorPeer {
  screen
  viewer
}

model Account {
  id            String      @id @default(cuid())
  name          String
  kind          AccountKind @default(client)
  parentId      String?
  parent        Account?    @relation("AccountChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children      Account[]   @relation("AccountChildren")
  isActive      Boolean     @default(true)
  logoUrl       String?
  loginImageUrl String?
  splashUrl     String?
  splashEnabled Boolean     @default(false)
  primaryColor  String?
  maxScreens    Int?
  maxInstagram  Int         @default(5)
  footer        Json?
  apkUrl        String?
  users         User[]
  companies     Company[]
  screens       Screen[]
  media         Media[]
  playlists     Playlist[]
  rssSources    RssSource[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([parentId])
}

model Company {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  document  String?
  contact   String?
  phone     String?
  screens   Screen[]
  media     Media[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model User {
  id              String                @id @default(cuid())
  accountId       String?
  account         Account?              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String
  email           String                @unique
  passwordHash    String
  role            UserRole              @default(admin)
  avatarUrl       String?
  timezone        String?
  isActive        Boolean               @default(true)
  restrictContent Boolean               @default(false)
  lastLoginAt     DateTime?
  screenAccess    UserScreenAccess[]
  commands        ScreenCommand[]
  mirrorSessions  ScreenMirrorSession[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([accountId])
}

model UserScreenAccess {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@id([userId, screenId])
  @@index([screenId])
}

model Media {
  id                String            @id @default(cuid())
  accountId         String?
  account           Account?          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title             String
  type              MediaType
  category          String?
  fileUrl           String            @default("")
  fileUrlVertical   String?
  thumbnailUrl      String?
  mimeType          String            @default("")
  sizeBytes         BigInt            @default(0)
  sizeBytesVertical BigInt?
  durationSeconds   Int?
  config            Json?
  recordStats       Boolean           @default(true)
  isLibrary         Boolean           @default(false)
  scheduleStartsAt  DateTime?
  scheduleEndsAt    DateTime?
  scheduleTimeFrom  String?
  scheduleTimeTo    String?
  scheduleWeekdays  Int[]             @default([])
  status            MediaStatus       @default(ready)
  orientation       MediaOrientation  @default(auto)
  rotationDegrees   Int               @default(0)
  processingError   String?
  readyAt           DateTime?
  playlistItems     PlaylistItem[]
  screenItems       ScreenItem[]
  playLogs          PlayLog[]
  heartbeats        ScreenHeartbeat[] @relation("HeartbeatCurrentMedia")
  events            ScreenEvent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([accountId])
  @@index([isLibrary])
  @@index([type])
  @@index([status])
  @@index([orientation])
}

model Playlist {
  id               String             @id @default(cuid())
  accountId        String?
  account          Account?           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  imageUrl         String?
  isLibrary        Boolean            @default(false)
  category         String?
  name             String
  description      String?
  isActive         Boolean            @default(true)
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  items            PlaylistItem[]
  assignments      ScreenAssignment[]
  screenItems      ScreenItem[]
  playLogs         PlayLog[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([accountId])
  @@index([isLibrary])
  @@index([isActive])
}

model PlaylistItem {
  id                     String   @id @default(cuid())
  playlistId             String
  playlist               Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaId                String
  media                  Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  order                  Int
  displayDurationSeconds Int?
  createdAt              DateTime @default(now())

  @@unique([playlistId, order])
  @@index([mediaId])
}

model Screen {
  id                    String                @id @default(cuid())
  accountId             String?
  account               Account?              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyId             String?
  company               Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name                  String
  slug                  String                @unique
  activationCode        String?               @unique
  deviceKey             String?               @unique
  deviceKeyHash         String?               @unique
  location              String?
  imageUrl              String?
  segment               String?
  street                String?
  streetNumber          String?
  complement            String?
  zipCode               String?
  district              String?
  state                 String?
  city                  String?
  phone1                String?
  phone2                String?
  openFrom              String?
  openTo                String?
  openDays              Int[]                 @default([])
  footfall              Int?
  socialClasses         String[]              @default([])
  refreshMinutes        Int                   @default(5)
  soundEnabled          Boolean               @default(false)
  timezone              String                @default("America/Sao_Paulo")
  footerEnabled         Boolean               @default(false)
  notes                 String?
  isFavorite            Boolean               @default(false)
  shuffle               Boolean               @default(false)
  orientation           ScreenOrientation     @default(landscape)
  status                ScreenStatus          @default(offline)
  lastSeenAt            DateTime?
  lastHeartbeat         Json?
  diagnostics           Json?
  lastHeartbeatStoredAt DateTime?
  items                 ScreenItem[]
  userAccess            UserScreenAccess[]
  playLogs              PlayLog[]
  assignments           ScreenAssignment[]
  heartbeats            ScreenHeartbeat[]
  events                ScreenEvent[]
  commands              ScreenCommand[]
  mirrorSessions        ScreenMirrorSession[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([orientation])
}

model ScreenAssignment {
  id         String   @id @default(cuid())
  screenId   String
  screen     Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Restrict)
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())

  @@index([screenId, isActive])
  @@index([playlistId])
}

model ScreenHeartbeat {
  id                      String       @id @default(cuid())
  screenId                String
  screen                  Screen       @relation(fields: [screenId], references: [id], onDelete: Cascade)
  status                  ScreenStatus
  appVersion              String?
  ipAddress               String?
  currentMediaId          String?
  currentMedia            Media?       @relation("HeartbeatCurrentMedia", fields: [currentMediaId], references: [id], onDelete: SetNull)
  currentPlaylistItemId   String?
  playbackPositionSeconds Float?
  playbackDurationSeconds Float?
  playbackState           String?
  sentAt                  DateTime

  @@index([screenId, sentAt])
  @@index([currentMediaId])
}

model ScreenEvent {
  id        String           @id @default(cuid())
  screenId  String
  screen    Screen           @relation(fields: [screenId], references: [id], onDelete: Cascade)
  level     ScreenEventLevel @default(info)
  type      String
  message   String
  mediaId   String?
  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([screenId, createdAt])
  @@index([level])
  @@index([mediaId])
}

model ScreenCommand {
  id             String              @id @default(cuid())
  screenId       String
  screen         Screen              @relation(fields: [screenId], references: [id], onDelete: Cascade)
  type           ScreenCommandType
  payload        Json?
  status         ScreenCommandStatus @default(pending)
  requestedById  String?
  requestedBy    User?               @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt    DateTime            @default(now())
  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  errorMessage   String?

  @@index([screenId, status, requestedAt])
  @@index([requestedById])
}

model ScreenMirrorSession {
  id            String                    @id @default(cuid())
  screenId      String
  screen        Screen                    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  status        ScreenMirrorSessionStatus @default(requested)
  requestedById String?
  requestedBy   User?                     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  offer         Json?
  answer        Json?
  errorMessage  String?
  candidates    ScreenMirrorCandidate[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  endedAt       DateTime?

  @@index([screenId, status, createdAt])
  @@index([requestedById])
}

model ScreenMirrorCandidate {
  id        String              @id @default(cuid())
  sessionId String
  session   ScreenMirrorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  peer      ScreenMirrorPeer
  candidate Json
  createdAt DateTime            @default(now())

  @@index([sessionId, peer, createdAt])
}

model ScreenItem {
  id              String    @id @default(cuid())
  screenId        String
  screen          Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  order           Int
  mediaId         String?
  media           Media?    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  playlistId      String?
  playlist        Playlist? @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  durationSeconds Int?
  createdAt       DateTime  @default(now())

  @@index([screenId, order])
  @@index([mediaId])
  @@index([playlistId])
}

model PlayLog {
  id              String    @id
  screenId        String
  screen          Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  mediaId         String
  media           Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  playlistId      String?
  playlist        Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  startedAt       DateTime
  durationSeconds Int
  receivedAt      DateTime  @default(now())

  @@index([screenId, startedAt])
  @@index([mediaId, startedAt])
  @@index([playlistId, startedAt])
}

model RssSource {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  url       String
  createdAt DateTime @default(now())

  @@index([accountId])
}

model ExternalCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())
  error     String?
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
