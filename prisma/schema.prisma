generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
}

enum MediaType {
  image
  video
}

enum ScreenStatus {
  online
  offline
}

enum ScreenOrientation {
  landscape
  portrait
}

enum MediaStatus {
  pending
  processing
  ready
  failed
}

enum MediaOrientation {
  auto
  landscape
  portrait
  square
}

enum ScreenEventLevel {
  info
  warn
  error
}

enum ScreenCommandType {
  refresh_playlist
  clear_cache
  restart_player
  reload_app
  open_overlay_settings
  remote_key
  start_screen_mirror
  stop_screen_mirror
}

enum ScreenCommandStatus {
  pending
  delivered
  acknowledged
  failed
}

enum ScreenMirrorSessionStatus {
  requested
  connecting
  active
  ended
  failed
}

enum ScreenMirrorPeer {
  screen
  viewer
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(admin)
  commands     ScreenCommand[]
  mirrorSessions ScreenMirrorSession[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Media {
  id              String            @id @default(cuid())
  title           String
  type            MediaType
  fileUrl         String
  mimeType        String
  sizeBytes       BigInt
  durationSeconds Int?
  status          MediaStatus       @default(ready)
  orientation     MediaOrientation  @default(auto)
  rotationDegrees Int               @default(0)
  processingError String?
  readyAt         DateTime?
  playlistItems   PlaylistItem[]
  heartbeats      ScreenHeartbeat[] @relation("HeartbeatCurrentMedia")
  events          ScreenEvent[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([orientation])
}

model Playlist {
  id          String             @id @default(cuid())
  name        String
  description String?
  isActive    Boolean            @default(true)
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  items       PlaylistItem[]
  assignments ScreenAssignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive])
}

model PlaylistItem {
  id                     String   @id @default(cuid())
  playlistId             String
  playlist               Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaId                String
  media                  Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  order                  Int
  displayDurationSeconds Int?
  createdAt              DateTime @default(now())

  @@unique([playlistId, order])
  @@index([mediaId])
}

model Screen {
  id             String             @id @default(cuid())
  name           String
  slug           String             @unique
  activationCode String             @unique
  deviceKey      String?            @unique
  location       String?
  orientation    ScreenOrientation  @default(landscape)
  status         ScreenStatus       @default(offline)
  lastSeenAt     DateTime?
  assignments    ScreenAssignment[]
  heartbeats     ScreenHeartbeat[]
  events         ScreenEvent[]
  commands       ScreenCommand[]
  mirrorSessions ScreenMirrorSession[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@index([orientation])
}

model ScreenAssignment {
  id           String   @id @default(cuid())
  screenId     String
  screen       Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  playlistId   String
  playlist     Playlist @relation(fields: [playlistId], references: [id], onDelete: Restrict)
  isActive     Boolean  @default(true)
  assignedAt   DateTime @default(now())

  @@index([screenId, isActive])
  @@index([playlistId])
}

model ScreenHeartbeat {
  id             String                @id @default(cuid())
  screenId       String
  screen         Screen                @relation(fields: [screenId], references: [id], onDelete: Cascade)
  status         ScreenStatus
  appVersion     String?
  ipAddress      String?
  currentMediaId String?
  currentMedia   Media?                @relation("HeartbeatCurrentMedia", fields: [currentMediaId], references: [id], onDelete: SetNull)
  currentPlaylistItemId     String?
  playbackPositionSeconds   Float?
  playbackDurationSeconds   Float?
  playbackState             String?
  sentAt         DateTime

  @@index([screenId, sentAt])
  @@index([currentMediaId])
}

model ScreenEvent {
  id        String           @id @default(cuid())
  screenId  String
  screen    Screen           @relation(fields: [screenId], references: [id], onDelete: Cascade)
  level     ScreenEventLevel @default(info)
  type      String
  message   String
  mediaId   String?
  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([screenId, createdAt])
  @@index([level])
  @@index([mediaId])
}

model ScreenCommand {
  id             String              @id @default(cuid())
  screenId       String
  screen         Screen              @relation(fields: [screenId], references: [id], onDelete: Cascade)
  type           ScreenCommandType
  payload        Json?
  status         ScreenCommandStatus @default(pending)
  requestedById  String?
  requestedBy    User?               @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt    DateTime            @default(now())
  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  errorMessage   String?

  @@index([screenId, status, requestedAt])
  @@index([requestedById])
}

model ScreenMirrorSession {
  id             String                    @id @default(cuid())
  screenId       String
  screen         Screen                    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  status         ScreenMirrorSessionStatus @default(requested)
  requestedById  String?
  requestedBy    User?                     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  offer          Json?
  answer         Json?
  errorMessage   String?
  candidates     ScreenMirrorCandidate[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  endedAt        DateTime?

  @@index([screenId, status, createdAt])
  @@index([requestedById])
}

model ScreenMirrorCandidate {
  id        String              @id @default(cuid())
  sessionId String
  session   ScreenMirrorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  peer      ScreenMirrorPeer
  candidate Json
  createdAt DateTime            @default(now())

  @@index([sessionId, peer, createdAt])
}
