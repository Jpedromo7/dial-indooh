{
  "name": "dial-indooh-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Full-stack digital signage foundation for Android TV boxes.",
  "workspaces": [
    "apps/web",
    "apps/tv",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @dialindooh/web",
    "dev:tv": "npm run start -w @dialindooh/tv",
    "build:web": "npm run prisma:generate && npm run build -w @dialindooh/web",
    "build": "npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.prisma",
    "migrate:postgres": "node scripts/migrate-postgres.mjs",
    "migrate:storage": "node scripts/migrate-storage-to-r2.mjs",
    "test": "npm test -w @dialindooh/web",
    "migrate:v2": "node scripts/migrate-v2.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.0.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^6.0.0",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
